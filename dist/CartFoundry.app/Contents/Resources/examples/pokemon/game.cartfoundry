            }
        ],
        "scenes": [
            {
                "id": "scene_main",
                "name": "Main Scene"
            }
        ],
        "scripts": [
            {
                "id": "show_battle",
                "name": "Show the wild Pokemon",
                "source": "if species == 1\n dialogue battle_bulbasaur\nelse\n if species == 2\n  dialogue battle_charmander\n else\n  dialogue battle_squirtle\n end\nend"
            },
            {
                "id": "wild_encounter",
                "name": "Start a wild encounter",
                "source": "if hp > 0\n set wild_hp 10\n random species 1 3\n call show_battle\nend"
            },
            {
                "id": "hurt_player",
                "name": "Wild Pokemon attacks",
                "source": "random damage 1 3\nsub hp damage\nif hp < 0\n set hp 0\nend"
            },
            {
                "id": "attack_turn",
                "name": "Pikachu attacks",
                "source": "random damage 2 4\nsub wild_hp damage\nif wild_hp <= 0\n set wild_hp 0\n add wins 1\n dialogue victory\nelse\n call hurt_player\n if hp == 0\n  dialogue fainted\n else\n  call show_battle\n end\nend"
            },
            {
                "id": "store_capture",
                "name": "Store a caught Pokemon",
                "source": "if species == 1\nif has party bulbasaur >= 1\n dialogue already_owned\nelse\n give party bulbasaur 1\n if result == 1\n  add caught 1\n  dialogue caught_bulbasaur\n else\n  dialogue party_full\n end\nend\nelse\nif species == 2\nif has party charmander >= 1\n dialogue already_owned\nelse\n give party charmander 1\n if result == 1\n  add caught 1\n  dialogue caught_charmander\n else\n  dialogue party_full\n end\nend\nelse\nif has party squirtle >= 1\n dialogue already_owned\nelse\n give party squirtle 1\n if result == 1\n  add caught 1\n  dialogue caught_squirtle\n else\n  dialogue party_full\n end\nend\nend\nend\n"
            },
            {
                "id": "throw_ball",
                "name": "Try to catch the wild Pokemon",
                "source": "take inventory pokeball 1\nif result == 1\n random roll 1 100\n if wild_hp <= 4\n  set roll 1\n end\n if roll <= 35\n  call store_capture\n else\n  call hurt_player\n  if hp == 0\n   dialogue fainted\n  else\n   dialogue catch_failed\n  end\n end\nelse\n dialogue no_balls\nend"
            },
            {
                "id": "heal",
                "name": "Heal and refill balls",
                "source": "set hp 20\nif has inventory pokeball < 5\n give inventory pokeball 5\nend"
            },
            {
                "id": "report",
                "name": "Check the collection",
                "source": "if has party bulbasaur >= 1\n if has party charmander >= 1\n  if has party squirtle >= 1\n   dialogue complete\n  else\n   dialogue progress\n  end\n else\n  dialogue progress\n end\nelse\n dialogue progress\nend"
            }
        ],
