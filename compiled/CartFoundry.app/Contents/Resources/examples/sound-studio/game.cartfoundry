            "id": "welcome",
            "modal": false,
            "onEnter": "",
            "portrait": "",
            "position": [
                60,
                130
            ],
            "text": "Welcome, traveller.\nA warm light glows\ninside the foundry.\nWhat will you do?",
            "textStyle": {
                "align": 0,
                "border": true,
                "choiceSpacing": 1,
