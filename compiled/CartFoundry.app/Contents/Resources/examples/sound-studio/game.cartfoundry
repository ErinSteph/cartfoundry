        },
        {
            "choices": [
                {
                    "actions": "",
                    "condition": "",
                    "target": "quest",
                    "text": "Follow the sign"
                },
                {
                    "actions": "",
                    "condition": "",
                    "target": "welcome",
                    "text": "Turn back"
                }
            ],
            "id": "path",
            "modal": false,
            "onEnter": "",
            "portrait": "",
            "position": [
                420,
                390
            ],
            "text": "You find a sign:\nTHIS WAY TO\nSOMETHING NEW.\nWhere does it lead?",
            "textStyle": {
                "align": 0,
                "border": true,
                "choiceSpacing": 1,
                "cursor": ">",
                "disabledMarker": "x",
                "footer": "",
                "padding": 1,
