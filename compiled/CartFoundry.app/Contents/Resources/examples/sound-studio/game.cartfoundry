                    "target": "quest",
                    "text": "Ask about a quest"
                },
                {
                    "actions": "",
                    "condition": "",
                    "target": "welcome",
                    "text": "Go outside"
                }
            ],
            "id": "foundry",
            "modal": false,
            "onEnter": "",
            "portrait": "",
            "position": [
                420,
                50
            ],
            "text": "The keeper smiles.\nEvery adventure\nstarts with a\nsingle choice.",
            "textStyle": {
                "align": 0,
