                "showTitle": true
            },
            "textbox": [
                0,
                0,
                20,
                18
            ],
            "title": "THE OLD PATH"
        },
        {
            "choices": [
                {
                    "actions": "",
                    "condition": "",
                    "target": "welcome",
                    "text": "Start again"
                }
            ],
            "id": "quest",
            "modal": false,
            "onEnter": "",
            "portrait": "",
            "position": [
