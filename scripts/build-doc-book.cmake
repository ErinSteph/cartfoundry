# Generate a self-contained documentation edition from the current sources.
get_filename_component(CF_DOC_SOURCE "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED CF_DOC_VERSION OR NOT DEFINED CF_DOC_OUTPUT)
    message(FATAL_ERROR "Set CF_DOC_VERSION and CF_DOC_OUTPUT.")
endif()
file(MAKE_DIRECTORY "${CF_DOC_OUTPUT}/docs")
foreach(chapter handbook editor-authoring map-authoring project-format application-updates)
    configure_file("${CF_DOC_SOURCE}/docs/${chapter}.md" "${CF_DOC_OUTPUT}/docs/${chapter}.md" COPYONLY)
    file(READ "${CF_DOC_OUTPUT}/docs/${chapter}.md" chapter_text)
    string(REGEX REPLACE "^# ([^\n]+)" "# \\1 — CartFoundry ${CF_DOC_VERSION}" chapter_text "${chapter_text}")
    file(WRITE "${CF_DOC_OUTPUT}/docs/${chapter}.md" "${chapter_text}")
endforeach()
foreach(example pokemon menu-saves scenes)
    file(MAKE_DIRECTORY "${CF_DOC_OUTPUT}/examples/${example}")
    configure_file("${CF_DOC_SOURCE}/examples/${example}/README.md" "${CF_DOC_OUTPUT}/examples/${example}/README.md" COPYONLY)
endforeach()
file(WRITE "${CF_DOC_OUTPUT}/book.json" "{\"product\":\"CartFoundry\",\"version\":\"${CF_DOC_VERSION}\"}\n")
file(WRITE "${CF_DOC_OUTPUT}/README.md" "# CartFoundry ${CF_DOC_VERSION} documentation\n\nThis edition belongs to CartFoundry **${CF_DOC_VERSION}**. Older application builds may lack these features.\n\n- [Handbook and worked examples](docs/handbook.md)\n- [Authoring controls and commands](docs/editor-authoring.md)\n- [Map building](docs/map-authoring.md)\n- [Project format](docs/project-format.md)\n- [Application updates](docs/application-updates.md)\n- [Pokémon walkthrough](examples/pokemon/README.md)\n- [Menus and saves example](examples/menu-saves/README.md)\n- [Scenes and screens example](examples/scenes/README.md)\n\nIn this desktop version, open **Help → Documentation book…** (F1) for offline search and examples. The app reads its bundled edition, rather than downloading the newest documentation.\n")
