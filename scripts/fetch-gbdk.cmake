# Developer bootstrap. GBDK_PLATFORM and GBDK_DESTINATION support isolated cross-builds.
cmake_minimum_required(VERSION 3.21)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT GBDK_PLATFORM)
    execute_process(COMMAND uname -m OUTPUT_VARIABLE ARCH OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
        if(ARCH STREQUAL "arm64")
            set(GBDK_PLATFORM macos-arm64)
        else()
            set(GBDK_PLATFORM macos-x86_64)
        endif()
    elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
        set(GBDK_PLATFORM windows-x86_64)
    elseif(ARCH STREQUAL "aarch64")
        set(GBDK_PLATFORM linux-arm64)
    else()
        set(GBDK_PLATFORM linux-x86_64)
    endif()
endif()
if(GBDK_PLATFORM STREQUAL "macos-arm64")
    set(ASSET gbdk-macos-arm64.tar.gz)
    set(HASH 289ee60e46c5a2785a21e35533f84a5131ed4a063b21b0dbdedc9a10af15bf78)
elseif(GBDK_PLATFORM STREQUAL "macos-x86_64")
    set(ASSET gbdk-macos.tar.gz)
    set(HASH 1aa549d12032d8f6509d11923bb28b1a453098f42597feb378e9a42541f8fd89)
elseif(GBDK_PLATFORM STREQUAL "windows-x86_64")
    set(ASSET gbdk-win64.zip)
    set(HASH 266854ce92e3064871c5b28cd3436cc2a6cb136af9e7cf617140108f8c1c5890)
elseif(GBDK_PLATFORM STREQUAL "linux-arm64")
    set(ASSET gbdk-linux-arm64.tar.gz)
    set(HASH 31eb2235f0fdb60163d0b1e9574a022098d6069cd56606a1daca4478a46e0439)
elseif(GBDK_PLATFORM STREQUAL "linux-x86_64")
    set(ASSET gbdk-linux64.tar.gz)
    set(HASH d7857a5f6d135ee4c249043ca26aad9f2ec8ab5d4106d97720d404114f42605c)
else()
    message(FATAL_ERROR "Unsupported GBDK_PLATFORM: ${GBDK_PLATFORM}")
endif()
if(NOT GBDK_DESTINATION)
    set(GBDK_DESTINATION "${ROOT}/tools")
endif()
file(MAKE_DIRECTORY "${ROOT}/build/downloads" "${GBDK_DESTINATION}")
set(ARCHIVE "${ROOT}/build/downloads/${ASSET}")
set(CACHED_HASH "")
if(EXISTS "${ARCHIVE}")
    file(SHA256 "${ARCHIVE}" CACHED_HASH)
endif()
if(NOT CACHED_HASH STREQUAL HASH)
    file(DOWNLOAD "https://github.com/gbdk-2020/gbdk-2020/releases/download/4.5.0/${ASSET}" "${ARCHIVE}" EXPECTED_HASH SHA256=${HASH} SHOW_PROGRESS STATUS RESULT)
    list(GET RESULT 0 STATUS_CODE)
    if(NOT STATUS_CODE EQUAL 0)
        message(FATAL_ERROR "GBDK download failed: ${RESULT}")
    endif()
endif()
file(ARCHIVE_EXTRACT INPUT "${ARCHIVE}" DESTINATION "${GBDK_DESTINATION}")
message(STATUS "GBDK 4.5.0 (${GBDK_PLATFORM}) ready in ${GBDK_DESTINATION}/gbdk")
