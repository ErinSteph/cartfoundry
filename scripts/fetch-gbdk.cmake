# Run with cmake -P scripts/fetch-gbdk.cmake. Only a developer bootstrap step.
cmake_minimum_required(VERSION 3.21)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    execute_process(COMMAND uname -m OUTPUT_VARIABLE ARCH OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(ARCH STREQUAL "arm64")
        set(ASSET gbdk-macos-arm64.tar.gz)
        set(HASH 289ee60e46c5a2785a21e35533f84a5131ed4a063b21b0dbdedc9a10af15bf78)
    else()
        set(ASSET gbdk-macos.tar.gz)
        set(HASH 1aa549d12032d8f6509d11923bb28b1a453098f42597feb378e9a42541f8fd89)
    endif()
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
    set(ASSET gbdk-win64.zip)
    set(HASH 266854ce92e3064871c5b28cd3436cc2a6cb136af9e7cf617140108f8c1c5890)
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    execute_process(COMMAND uname -m OUTPUT_VARIABLE ARCH OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(ARCH STREQUAL "aarch64")
        set(ASSET gbdk-linux-arm64.tar.gz)
        set(HASH 31eb2235f0fdb60163d0b1e9574a022098d6069cd56606a1daca4478a46e0439)
    else()
        set(ASSET gbdk-linux64.tar.gz)
        set(HASH d7857a5f6d135ee4c249043ca26aad9f2ec8ab5d4106d97720d404114f42605c)
    endif()
else()
    message(FATAL_ERROR "Unsupported developer host")
endif()
file(MAKE_DIRECTORY "${ROOT}/build/downloads")
set(ARCHIVE "${ROOT}/build/downloads/${ASSET}")
file(DOWNLOAD "https://github.com/gbdk-2020/gbdk-2020/releases/download/4.5.0/${ASSET}" "${ARCHIVE}" EXPECTED_HASH SHA256=${HASH} SHOW_PROGRESS STATUS RESULT)
list(GET RESULT 0 STATUS_CODE)
if(NOT STATUS_CODE EQUAL 0)
    message(FATAL_ERROR "GBDK download failed: ${RESULT}")
endif()
file(MAKE_DIRECTORY "${ROOT}/tools")
file(ARCHIVE_EXTRACT INPUT "${ARCHIVE}" DESTINATION "${ROOT}/tools")
message(STATUS "GBDK 4.5.0 ready in tools/gbdk")
