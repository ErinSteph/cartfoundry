cmake_minimum_required(VERSION 3.21)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(EXISTS "${ROOT}/third_party/mgba/CMakeLists.txt")
    message(STATUS "Pinned mGBA source already present")
    return()
endif()
file(MAKE_DIRECTORY "${ROOT}/build/downloads")
set(ARCHIVE "${ROOT}/build/downloads/mgba-0.10.5.tar.gz")
file(DOWNLOAD "https://github.com/mgba-emu/mgba/archive/refs/tags/0.10.5.tar.gz" "${ARCHIVE}" EXPECTED_HASH SHA256=91d6fbd32abcbdf030d58d3f562de25ebbc9d56040d513ff8e5c19bee9dacf14 SHOW_PROGRESS)
file(MAKE_DIRECTORY "${ROOT}/third_party")
file(ARCHIVE_EXTRACT INPUT "${ARCHIVE}" DESTINATION "${ROOT}/third_party")
file(RENAME "${ROOT}/third_party/mgba-0.10.5" "${ROOT}/third_party/mgba")
